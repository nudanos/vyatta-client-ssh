import os
import sys
import syslog
from subprocess import check_output

from vyatta import configd

GlobalSSHConfig = '/etc/ssh/ssh_config'
CustomKEXConfig = '/etc/vyatta/ssh_kex_config'
CustomHKAConfig = '/etc/vyatta/ssh_hka_config'

DISALLOWED_KEX = ['diffie-hellman-group1-sha1',
                  'diffie-hellman-group14-sha1',
                  'diffie-hellman-group-exchange-sha1']

disallowedHKAList = ['ssh-dss']


def update_global_config():

    search = f"Include {CustomHKAConfig}\n"
    with open(GlobalSSHConfig, encoding='utf-8') as global_config:
        if any(line == search for line in global_config):
            return
    with open(GlobalSSHConfig, "a", encoding='utf-8') as global_config:
        global_config.write("Include /etc/vyatta/ssh_kex_config\n")
        global_config.write("Include /etc/vyatta/ssh_hka_config\n")


def get_config(name):

    try:
        configd_client = configd.Client()
    except configd.FatalException as f:
        print(f"can't connect to configd: {f}\n")
        sys.exit(1)

    try:
        top_cfg = configd_client.tree_get_dict(
            f"security ssh-client permit {name}",
            configd.Client.CANDIDATE, "json")
        cfg = top_cfg[name]
    except configd.Exception:
        cfg = None

    return cfg


#
# Disable by default some legacy SSH Key Exchange Algorithms unless
# explicitly permitted by configuration.
#
# if "default" is True, exclude the default set of weak algorithms
# independent of configuration.
#
def update_kex(default=False):

    enabled = None if default else get_config('key-exchange-algorithm')

    disallowed = DISALLOWED_KEX
    if enabled is not None:
        disallowed = [a for a in DISALLOWED_KEX if a not in enabled]

    # filtered here, as "| egrep -v 'a|b|c'" did: drop any algorithm whose
    # name contains a disallowed one (egrep is obsolete in trixie, and its
    # exit status failed the pipeline when it dropped every line)
    kex = check_output(["ssh", "-Q", "kex"]).decode("utf-8")
    algs = [alg for alg in kex.splitlines()
            if not any(d in alg for d in disallowed)]
    algstr = ",".join(algs)

    with open(CustomKEXConfig, "w", encoding='utf-8') as custom_config:
        custom_config.write("Host *\n")
        custom_config.write(f"    KexAlgorithms {algstr}\n")

    if enabled:
        algstr = ",".join(enabled)
        syslog.syslog(syslog.LOG_WARNING,
                      f"SSH: Key Exchange Algorithms {algstr} enabled.\n")


#
# Configure some legacy SSH Host Key Algorithms
#
def update_hka():

    hka = get_config('host-key-algorithm')

    if hka is None:
        try:
            os.remove(CustomHKAConfig)
        except OSError:
            pass
        return
    hka = hka[0]

    with open(CustomHKAConfig, "w", encoding='utf-8') as custom_config:
        custom_config.write("Host *\n")
        custom_config.write(f"    HostKeyAlgorithms +{hka}\n")

    syslog.syslog(syslog.LOG_WARNING,
                  f"SSH: Legacy Host Key Algorithms {hka} enabled.\n")


if sys.argv[1] == 'defaults':
    if not os.path.isfile(CustomKEXConfig):
        update_global_config()
        update_kex(True)

elif sys.argv[1] == 'update-legacy':
    update_hka()
    update_kex()

else:
    print("No handler\n")
